# Linear 개인 API 키. 비워 두면 개발 서버와 테스트는 고정 예시 데이터로 동작한다.
# 운영(Vercel production)에서 비어 있으면 오류 화면을 보여 준다.
LINEAR_API_KEY=

# 달력 「일정 보기」에서 일정을 추가·수정·삭제할 때 넣는 팀 비밀번호. 비워 두면 아무도 바꿀 수 없다.
# 시도 횟수 제한이 없어서 16자 이상의 무작위 문자로 정한다.
SCHEDULE_PASSWORD=

# 팀 일정을 저장할 Firebase 서비스 계정 값. 세 개가 모두 있어야 Firestore를 쓴다.
# 비워 두면 로컬 개발 서버는 서버 메모리에 저장하고(다시 켜면 사라짐), Vercel(운영·미리보기)에서는 오류를 낸다.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# 키 파일의 private_key 값. 줄바꿈은 \n 글자 그대로 넣어도 된다.
FIREBASE_PRIVATE_KEY=

# 「이용 통계」가 크루런 GA4 숫자를 읽을 때 쓴다. 둘 중 하나라도 비우면 「GA4 연결 정보가 없어요」가 보인다.
# GA4 속성 ID(숫자). GA4 관리 → 속성 설정에 있다. 측정 ID(G-로 시작)가 아니다.
GA4_PROPERTY_ID=
# 서비스 계정 키 JSON 한 줄, 또는 그 JSON을 base64로 바꾼 한 줄. 서비스 계정에 GA4 속성 뷰어 권한이 있어야 한다.
GA4_SERVICE_ACCOUNT_KEY=

# 「링크 모음」 채점 리포트 암호문(reports/*.enc.json)을 푸는 RSA 개인키(PEM). 짝인 공개키는 reports/public-key.pem이다.
# 줄바꿈은 \n 글자 그대로 넣어도 된다. 비워 두면 비밀번호가 맞아도 리포트를 열 수 없다.
REPORTS_PRIVATE_KEY=
